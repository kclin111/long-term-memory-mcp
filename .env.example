# Long-Term Memory MCP local config
#
# Copy this file to .env and fill in secrets locally.
# Never commit .env.

# Storage
# If unset, the server uses the OS app-data directory.
LTM_HOME=.ltm-data

# SQLite defaults to WAL. Use MEMORY only in restricted sandboxes.
LTM_SQLITE_JOURNAL_MODE=WAL

# LLM Operator
# Use "none" for deterministic extraction without external API calls.
LTM_LLM_PROVIDER=openrouter
LTM_LLM_MODEL=openai/gpt-4o-mini
LTM_LLM_TIMEOUT_SECONDS=60

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=long-term-memory-mcp

# Optional embedding signature metadata. Current LanceDB adapter stores
# rebuildable records; real embedding-backed indexing can use these knobs.
LTM_EMBEDDING_PROVIDER=none
LTM_EMBEDDING_MODEL=
